font-size = 20

background = #282828
foreground = #ebdbb2
background-opacity = 0.5
cursor-color = #ebdbb2
selection-background = #504945
selection-foreground = #ebdbb2

palette = 0=#282828
palette = 1=#cc241d
palette = 2=#98971a
palette = 3=#d79921
palette = 4=#458588
palette = 5=#b16286
palette = 6=#689d6a
palette = 7=#a89984

palette = 8=#928374
palette = 9=#fb4934
palette = 10=#b8bb26
palette = 11=#fabd2f
palette = 12=#83a598
palette = 13=#d3869b
palette = 14=#8ec07c
palette = 15=#ebdbb2

gtk-titlebar = false
gtk-single-instance = false

shell-integration = none
shell-integration-features = no-cursor,no-sudo,no-title

keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+a=select_all
keybind = ctrl+shift+j=scroll_page_down
keybind = ctrl+shift+k=scroll_page_up
keybind = ctrl+shift+page_down=jump_to_prompt:1
keybind = ctrl+shift+comma=reload_config
